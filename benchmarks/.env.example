# OpenRouter API Key for running LLM benchmarks
OPENROUTER_API_KEY=your_key_here

# MCP Server API Keys (optional - only needed for specific servers)
# Get these from the respective services:

# National Park Service - https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# NASA Open Data - https://api.nasa.gov/
NASA_API_KEY=

# Hugging Face - https://huggingface.co/docs/hub/security-tokens
HF_TOKEN=

# Google Maps - https://developers.google.com/maps
GOOGLE_MAPS_API_KEY=

# National Cancer Institute - https://clinicaltrialsapi.cancer.gov/signin
NCI_API_KEY=
