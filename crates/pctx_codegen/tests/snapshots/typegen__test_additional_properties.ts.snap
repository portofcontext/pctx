  obj_additional_props: AdditionalPropertiesObjAdditionalProps;

  string_additional_props: AdditionalPropertiesStringAdditionalProps;

  true_additional_props: AdditionalPropertiesTrueAdditionalProps;

  false_additional_props: AdditionalPropertiesFalseAdditionalProps;

  only_additional_props_primitive: { [key: string]: string | undefined };

